{
  "name": "music-teacher",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:check": "vitest run src/i18n/locales.test.ts",
    "check": "tsc -b && eslint . && prettier --check . && vitest run",
    "desktop": "npm run build && electron .",
    "desktop:dist": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.49.0",
    "@tonejs/midi": "^2.0.28",
    "dexie": "^4.4.6",
    "i18next": "^26.4.4",
    "i18next-icu": "^2.5.0",
    "intl-messageformat": "^12.1.3",
    "opensheetmusicdisplay": "^2.2.1",
    "pitchy": "^4.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "react-router": "^7.18.4",
    "tone": "^15.1.22",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "description": "Learn piano with a MIDI keyboard or the microphone.",
  "author": "Juan Facorro",
  "main": "electron/main.js",
  "build": {
    "appId": "com.jfacorro.pianoteacher",
    "productName": "Music Teacher",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "locales/*/desktop.json",
      "build/icon.png",
      "package.json",
      "!**/node_modules/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "en_US",
        "es_ES"
      ],
      "artifactName": "Music-Teacher-Setup-${version}.${ext}"
    },
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist"
  }
}
